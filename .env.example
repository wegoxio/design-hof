# Server-only. Never prefix the API key with NEXT_PUBLIC_.
CATALOGUER_API_URL=http://localhost:3001/api/v1
CATALOGUER_API_KEY=ck_replace_with_a_read_only_catalogue_key
CATALOGUER_GENERAL_CHANNEL=mobiliario
CATALOGUER_H1_CHANNEL=mobiliario-h1
# Must match Cataloguer's CATALOGUE_REVALIDATION_SECRET; server-only.
CATALOGUER_REVALIDATION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Contact form (server-only). Verify design-hof.com in Resend before sending.
RESEND_API_KEY=re_replace_with_your_resend_key
# Optional overrides; the defaults below are already used by the application.
RESEND_FROM_EMAIL="Design HOF <contacto@design-hof.com>"
CONTACT_TO_EMAIL=info@design-hof.com
CONTACT_SITE_URL=https://www.design-hof.com
# Comma-separated extra origins (useful for local development and preview domains).
CONTACT_ALLOWED_ORIGINS=http://localhost:3002
